{
  "name": "devlink-secretariat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outil interne de gestion des rendez-vous pour cabinet d'orthophonie (Devlink secrétariat).",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "seed:fresh": "node server/seed.js --fresh",
    "test": "node scripts/smoke-test.mjs",
    "test:ui": "node scripts/ui-test.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "react-router-dom": "^6.30.6",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
