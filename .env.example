# ---------------------------------------------------------------------------
# Variables d'environnement
# Copier ce fichier en « .env » pour le développement local (facultatif).
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# En production (Netlify), la base est hébergée sur Turso (libSQL) car les
# fonctions serverless n'ont pas de disque persistant.
# Laisser vide en local : l'application utilise alors un fichier SQLite local
# (data/app.db, ou le chemin défini par DB_PATH).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Chemin du fichier SQLite local (développement / tests uniquement).
# DB_PATH=./data/app.db

# --- Serveur ---------------------------------------------------------------
# Port d'écoute du serveur local (4000 par défaut).
# PORT=4000
# Mettre « production » pour activer le cookie de session « Secure » (HTTPS).
# NODE_ENV=production
